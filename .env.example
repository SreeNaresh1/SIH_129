# ========================================================
# SIH-43 Portal - Root Environment Configuration Template
# ========================================================
# This project contains 3 decoupled services:
# - Frontend: frontend/
# - Backend API: server/
# - AI Service: ai-service/

# ====================
# BACKEND (server/.env)
# ====================
PORT=5000
DB_DIALECT=sqlite
DB_NAME=sih_portal
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
JWT_SECRET=your_jwt_secret_key_here
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=local_qwen
AI_MODEL=qwen2.5:7b

# =====================
# FRONTEND (frontend/.env)
# =====================
VITE_API_URL=http://localhost:5000/api
