/* =========================================================
   HELPER - GET UNIVERSITY FOR LOGGED-IN USER
========================================================= */

async function getUniversityForUser(userId) {

  const User =
    require("../models/User");

  const user =
    await User.findByPk(userId);

  if (!user) {
    return null;
  }

  if (!user.universityId) {
    return null;
  }

  const university =
    await University.findByPk(
      user.universityId
    );

  return university || null;
}


/* =========================================================
   HELPER - NOTIFICATION
========================================================= */

async function notify(
  userId,
  title,
  message,
  link = null,
  type = "system"
) {

  if (!userId) {
    return;
  }

  try {

    await Notification.create({

      userId,
      title,
      message,
      link,
      type

    });

  } catch (error) {

    console.error(
      "Notification error:",
      error.message
    );

  }

}


/* =========================================================
   AI ANALYSIS HELPER
========================================================= */

async function runAIAnalysis(problem) {

  try {

    const response =
      await fetch(
        `${AI_URL}/analyze`,
        {

          method:
            "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body:
            JSON.stringify({

              title:
                problem.title,

              description:
                problem.description,

              domain:
                problem.domain,

              severity:
                problem.severity,

              affectedPeople:
                problem.affectedPeople

            })

        }
      );

    if (!response.ok) {
      return null;
    }

    return await response.json();

  } catch (error) {

    console.error(
      "AI service error:",
      error.message
    );

    return null;

  }

}


/* =========================================================
   PRIORITY CALCULATION
========================================================= */

function calculatePriority(
  problem,
  ai
) {

  const severityBase = {

    Low:
      10,

    Medium:
      30,

    High:
      55,

    Critical:
      75

  }[
    problem.severity
  ] || 20;


  const people =
    Math.min(
      Number(
        problem.affectedPeople || 0
      ) / 20,
      20
    );


  const confidenceBoost =
    Math.min(
      Number(
        ai?.confidence || 0
      ) * 15,
      15
    );


  const score =
    Math.min(
      100,
      severityBase +
        people +
        confidenceBoost
    );


  const level =
    score >= 75
      ? "Critical"
      : score >= 55
      ? "High"
      : score >= 30
      ? "Medium"
      : "Low";


  return {

    score:
      Number(
        score.toFixed(2)
      ),

    level,

    breakdown: {

      severity:
        severityBase,

      affectedPeople:
        Number(
          people.toFixed(2)
        ),

      aiConfidenceBoost:
        Number(
          confidenceBoost.toFixed(2)
        )

    }

  };

}


/* =========================================================
   AI ANALYSIS
========================================================= */

router.post(
  "/problems/:problemId/ai-analyze",
  authenticateToken,
  authorizeRoles(
    "government",
    "university"
  ),
  async (req, res) => {

    try {

      const problem =
        await Problem.findOne({

          where: {

            problemId:
              req.params.problemId

          }

        });


      if (!problem) {

        return res.status(404).json({

          success: false,

          message:
            "Problem not found."

        });

      }


      const ai =
        await runAIAnalysis(
          problem
        );


      if (!ai) {

        return res.status(503).json({

          success: false,

          message:
            "AI service is unavailable."

        });

      }


      const priority =
        calculatePriority(
          problem,
          ai
        );


      await problem.update({

        aiDomain:
          ai.domain,

        aiSubDomain:
          ai.subDomain,

        aiSector:
          ai.sector,

        aiSeverity:
          ai.severity,

        aiConfidence:
          ai.confidence,

        priorityScore:
          priority.score,

        priorityLevel:
          priority.level,

        priorityBreakdown:
          JSON.stringify(
            priority.breakdown
          ),

        aiProcessedAt:
          new Date(),

        projectStatus:
          "AI Analysis Complete"

      });


      return res.json({

        success: true,

        ai,

        priority,

        problem

      });


    } catch (error) {

      console.error(
        "AI analysis error:",
        error
      );


      return res.status(500).json({

        success: false,

        message:
          "AI analysis failed."

      });

    }

  }
);


/* =========================================================
   AI RECOMMENDED UNIVERSITIES
========================================================= */

router.get(
  "/problems/:problemId/matches",
  authenticateToken,
  authorizeRoles("government"),
  async (req, res) => {

    try {

      const problem =
        await Problem.findOne({

          where: {

            problemId:
              req.params.problemId

          }

        });


      if (!problem) {

        return res.status(404).json({

          success: false,

          message:
            "Problem not found."

        });

      }


      const aiDomain =
        String(
          problem.aiDomain ||
          problem.domain ||
          ""
        )
          .trim();


      const aiSubDomain =
        String(
          problem.aiSubDomain ||
          ""
        )
          .trim();


      const aiSector =
        String(
          problem.aiSector ||
          ""
        )
          .trim();


      const aiSeverity =
        String(
          problem.aiSeverity ||
          problem.severity ||
          ""
        )
          .trim();


      const problemText = `

        ${problem.title || ""}

        ${problem.description || ""}

        ${problem.location || ""}

        ${problem.district || ""}

        ${aiDomain}

        ${aiSubDomain}

        ${aiSector}

      `
        .toLowerCase();


      let universities = [];


      try {

        universities =
          await University.findAll({

            where: {

              active:
                true

            },

            order: [

              [
                "name",
                "ASC"
              ]

            ]

          });

      } catch (error) {

        universities =
          await University.findAll({

            order: [

              [
                "name",
                "ASC"
              ]

            ]

          });

      }


      const expertiseRows =
        await UniversityExpertise.findAll();


      const matches =
        universities.map(
          (university) => {

            let score = 0;

            const reasons = [];

            let domainMatch =
              false;

            let subDomainMatch =
              false;

            let sectorKeywordMatch =
              false;

            let keywordMatch =
              false;

            let bestExpertiseLevel =
              0;

            let totalKeywordMatches =
              0;


            const universityExpertise =
              expertiseRows.filter(
                (item) =>
                  Number(
                    item.universityId
                  ) ===
                  Number(
                    university.id
                  )
              );


            if (aiDomain) {

              domainMatch =
                universityExpertise.some(
                  (item) => {

                    const universityDomain =
                      String(
                        item.domain || ""
                      )
                        .trim()
                        .toLowerCase();


                    const targetDomain =
                      aiDomain
                        .trim()
                        .toLowerCase();


                    if (
                      !universityDomain ||
                      !targetDomain
                    ) {

                      return false;

                    }


                    return (

                      universityDomain ===
                        targetDomain ||

                      universityDomain.includes(
                        targetDomain
                      ) ||

                      targetDomain.includes(
                        universityDomain
                      )

                    );

                  }
                );


              if (domainMatch) {

                score += 40;

                reasons.push(
                  `Domain match: ${aiDomain}`
                );

              }

            }


            if (aiSubDomain) {

              subDomainMatch =
                universityExpertise.some(
                  (item) => {

                    const universitySubDomain =
                      String(
                        item.subDomain || ""
                      )
                        .trim()
                        .toLowerCase();


                    const targetSubDomain =
                      aiSubDomain
                        .trim()
                        .toLowerCase();


                    if (
                      !universitySubDomain ||
                      !targetSubDomain
                    ) {

                      return false;

                    }


                    return (

                      universitySubDomain ===
                        targetSubDomain ||

                      universitySubDomain.includes(
                        targetSubDomain
                      ) ||

                      targetSubDomain.includes(
                        universitySubDomain
                      )

                    );

                  }
                );


              if (subDomainMatch) {

                score += 30;

                reasons.push(
                  `Sub-domain match: ${aiSubDomain}`
                );

              }

            }


            universityExpertise.forEach(
              (item) => {

                const keywordsText =
                  String(
                    item.keywords || ""
                  )
                    .toLowerCase()
                    .trim();


                if (!keywordsText) {
                  return;
                }


                const keywords =
                  keywordsText
                    .split(
                      /[,\n;|]+/
                    )
                    .map(
                      (keyword) =>
                        keyword.trim()
                    )
                    .filter(
                      Boolean
                    );


                keywords.forEach(
                  (keyword) => {

                    if (
                      keyword.length < 3
                    ) {

                      return;

                    }


                    if (
                      problemText.includes(
                        keyword
                      )
                    ) {

                      totalKeywordMatches++;

                    }


                    if (
                      aiSector &&
                      aiSector
                        .toLowerCase()
                        .includes(
                          keyword
                        )
                    ) {

                      sectorKeywordMatch =
                        true;

                    }

                  }
                );

              }
            );


            if (
              totalKeywordMatches > 0
            ) {

              keywordMatch =
                true;


              const keywordScore =
                Math.min(
                  15,
                  totalKeywordMatches * 3
                );


              score +=
                keywordScore;


              reasons.push(
                `${totalKeywordMatches} keyword match(es)`
              );

            }


            if (
              sectorKeywordMatch
            ) {

              score += 5;

              reasons.push(
                `Sector related to AI sector: ${aiSector}`
              );

            }


            universityExpertise.forEach(
              (item) => {

                const level =
                  Number(
                    item.expertiseLevel || 0
                  );


                if (
                  level >
                  bestExpertiseLevel
                ) {

                  bestExpertiseLevel =
                    level;

                }

              }
            );


            if (
              bestExpertiseLevel > 0
            ) {

              const expertiseScore =
                Math.min(
                  10,
                  bestExpertiseLevel * 2
                );


              score +=
                expertiseScore;


              reasons.push(
                `Expertise level: ${bestExpertiseLevel}/5`
              );

            }


            if (
              university.district &&
              problem.district &&
              String(
                university.district
              )
                .trim()
                .toLowerCase() ===
              String(
                problem.district
              )
                .trim()
                .toLowerCase()
            ) {

              score += 5;

              reasons.push(
                "Same district"
              );

            }


            if (
              university.city &&
              problem.location
            ) {

              const city =
                String(
                  university.city
                )
                  .trim()
                  .toLowerCase();


              const location =
                String(
                  problem.location
                )
                  .trim()
                  .toLowerCase();


              if (
                city &&
                location &&
                location.includes(city)
              ) {

                score += 5;

                reasons.push(
                  "University city matches problem location"
                );

              }

            }


            const hasAIExpertiseMatch =
              domainMatch ||
              subDomainMatch ||
              keywordMatch ||
              sectorKeywordMatch;


            if (
              !hasAIExpertiseMatch
            ) {

              score =
                Math.min(
                  score,
                  10
                );


              reasons.push(
                "No direct AI expertise match"
              );

            }


            score =
              Math.min(
                100,
                Number(
                  score.toFixed(2)
                )
              );


            let matchLevel =
              "Low";


            if (
              score >= 80
            ) {

              matchLevel =
                "Excellent";

            } else if (
              score >= 65
            ) {

              matchLevel =
                "Strong";

            } else if (
              score >= 45
            ) {

              matchLevel =
                "Good";

            } else if (
              score >= 25
            ) {

              matchLevel =
                "Moderate";

            }


            return {

              university: {

                id:
                  university.id,

                name:
                  university.name,

                code:
                  university.code,

                city:
                  university.city,

                district:
                  university.district,

                state:
                  university.state,

                website:
                  university.website,

                description:
                  university.description,

                contactEmail:
                  university.contactEmail

              },

              score,

              matchLevel,

              domainMatch,

              subDomainMatch,

              keywordMatch,

              sectorKeywordMatch,

              expertiseLevel:
                bestExpertiseLevel,

              keywordMatches:
                totalKeywordMatches,

              reasons,

              expertise:
                universityExpertise.map(
                  (item) => ({

                    id:
                      item.id,

                    universityId:
                      item.universityId,

                    domain:
                      item.domain,

                    subDomain:
                      item.subDomain,

                    expertiseLevel:
                      item.expertiseLevel,

                    keywords:
                      item.keywords

                  })
                )

            };

          }
        );


      matches.sort(
        (a, b) =>
          b.score -
          a.score
      );


      const recommendedMatches =
        matches.filter(
          (item) =>
            item.domainMatch ||
            item.subDomainMatch ||
            item.keywordMatch ||
            item.sectorKeywordMatch
        );


      const finalMatches =
        recommendedMatches.length > 0
          ? recommendedMatches.slice(
              0,
              10
            )
          : matches.slice(
              0,
              10
            );


      return res.json({

        success: true,

        recommendationEngine:
          "Trained AI + University Expertise Matching",

        problem: {

          problemId:
            problem.problemId,

          title:
            problem.title,

          description:
            problem.description,

          citizenDomain:
            problem.domain,

          aiDomain:
            problem.aiDomain,

          aiSubDomain:
            problem.aiSubDomain,

          aiSector:
            problem.aiSector,

          aiSeverity:
            problem.aiSeverity,

          aiConfidence:
            problem.aiConfidence,

          district:
            problem.district,

          location:
            problem.location

        },

        count:
          finalMatches.length,

        matches:
          finalMatches

      });


    } catch (error) {

      console.error(
        "University AI matching error:",
        error
      );


      return res.status(500).json({

        success: false,

        message:
          "Unable to calculate AI university recommendations.",

        error:
          process.env.NODE_ENV ===
          "development"
            ? error.message
            : undefined

      });

    }

  }
);


/* =========================================================
   GOVERNMENT ASSIGN UNIVERSITY
========================================================= */

router.post(
  "/problems/:problemId/assign",
  authenticateToken,
  authorizeRoles("government"),
  async (req, res) => {

    try {

      const {
        universityId
      } = req.body;


      if (!universityId) {

        return res.status(400).json({

          success: false,

          message:
            "universityId is required."

        });

      }


      const problem =
        await Problem.findOne({

          where: {

            problemId:
              req.params.problemId

          }

        });


      if (!problem) {

        return res.status(404).json({

          success: false,

          message:
            "Problem not found."

        });

      }


      const university =
        await University.findByPk(
          universityId
        );


      if (!university) {

        return res.status(404).json({

          success: false,

          message:
            "University not found."

        });

      }


      if (
        university.active ===
        false
      ) {

        return res.status(400).json({

          success: false,

          message:
            "This university is inactive."

        });

      }


      await problem.update({

        assignedUniversityId:
          university.id,

        assignedBy:
          req.user.id,

        assignedAt:
          new Date(),

        status:
          "Approved",

        projectStatus:
          "Assigned"

      });


      const [
        project,
        created
      ] =
        await Project.findOrCreate({

          where: {

            problemId:
              problem.problemId

          },

          defaults: {

            problemId:
              problem.problemId,

            universityId:
              university.id,

            status:
              "Assigned",

            progressPercent:
              0

          }

        });


      const projectNeedsUpdate =
        Number(
          project.universityId || 0
        ) !==
        Number(
          university.id
        ) ||
        project.status !==
          "Assigned";


      if (
        projectNeedsUpdate
      ) {

        await project.update({

          universityId:
            university.id,

          status:
            "Assigned"

        });

      }


      await project.reload();


      try {

        const User =
          require(
            "../models/User"
          );


        const universityUser =
          await User.findOne({

            where: {

              universityId:
                university.id,

              role:
                "university"

            }

          });


        if (
          universityUser
        ) {

          await notify(

            universityUser.id,

            "New Challenge Assigned",

            `${problem.problemId} has been assigned to ${university.name}.`,

            `/university/problem/${problem.problemId}`,

            "assignment"

          );

        }

      } catch (
        notificationError
      ) {

        console.error(
          "Assignment notification error:",
          notificationError.message
        );

      }


      return res.json({

        success: true,

        message:
          "University assigned successfully.",

        createdProject:
          created,

        problem,

        project,

        university

      });


    } catch (error) {

      console.error(
        "University assignment error:",
        error
      );


      return res.status(500).json({

        success: false,

        message:
          "University assignment failed.",

        error:
          process.env.NODE_ENV ===
          "development"
            ? error.message
            : undefined

      });

    }

  }
);


