# ========================================================
# SIH-43 Portal - Backend Server Environment Configuration
# ========================================================

# Server Port
PORT=5000

# Database Configuration (sqlite or mysql)
DB_DIALECT=sqlite
DB_NAME=sih_portal
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# AI Microservice Integration
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=local_qwen
AI_MODEL=qwen2.5:7b

# Ollama LLM Configuration (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
